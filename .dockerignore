# ==============================================================================
# .dockerignore — ShopifyClon API Core
# Excluye todo lo innecesario del contexto de build Docker
# ==============================================================================

# --- Control de versiones ---
.git
.gitignore
.gitattributes

# --- IDEs ---
.idea
.vscode
*.iml
*.iws
*.ipr

# --- Build local (se reconstruye dentro del contenedor) ---
target/

# --- Secretos y variables de entorno (NUNCA dentro de la imagen) ---
.env
.env.*

# --- Documentación ---
README.md
HELP.md
LICENSE

# --- Logs ---
*.log

# --- Docker (evitar recursión) ---
Dockerfile
.dockerignore
docker-compose*.yml

# --- OS ---
.DS_Store
Thumbs.db

# --- SQL sueltos ---
# OJO: src/main/resources/db/migration NO se excluye: Flyway lee las migraciones desde el jar.
*.sql
!src/main/resources/db/migration/*.sql
